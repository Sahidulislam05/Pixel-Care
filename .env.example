# Express API origin (server-side only; the browser calls /api/v1 on this app).
BACKEND_URL=http://localhost:5000

# Public URL of this frontend (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in for patients. Same OAuth Web Client ID as the backend GOOGLE_CLIENT_ID.
# Add this app's origin (e.g. http://localhost:3000) under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Demo login buttons. Use the tester accounts seeded by the backend
# (TESTER_* values in the backend .env). Leave empty to hide a button.
NEXT_PUBLIC_DEMO_PATIENT_EMAIL=
NEXT_PUBLIC_DEMO_PATIENT_PASSWORD=
NEXT_PUBLIC_DEMO_DOCTOR_EMAIL=
NEXT_PUBLIC_DEMO_DOCTOR_PASSWORD=
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
