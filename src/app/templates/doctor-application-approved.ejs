<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>Application Approved | PixelCare</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f3f7fb;
        color: #243247;
        font-family: "Inter", Arial, Helvetica, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      table {
        border-spacing: 0;
        border-collapse: collapse;
      }

      .email-wrapper {
        width: 100%;
        padding: 40px 16px;
        background-color: #f3f7fb;
      }

      .email-container {
        width: 100%;
        max-width: 580px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 35px rgba(28, 50, 80, 0.07);
      }

      .email-header {
        padding: 30px 40px;
        border-bottom: 1px solid #edf1f5;
      }

      .brand-icon {
        display: inline-block;
        width: 36px;
        height: 36px;
        line-height: 36px;
        text-align: center;
        background-color: #e6f5f3;
        color: #0b9688;
        border-radius: 10px;
        font-size: 23px;
        font-weight: 700;
        vertical-align: middle;
        margin-right: 9px;
      }

      .brand-name {
        color: #153e75;
        font-size: 23px;
        font-weight: 800;
        letter-spacing: -0.8px;
        vertical-align: middle;
      }

      .email-content {
        padding: 42px 40px 35px;
      }

      .success-icon {
        width: 66px;
        height: 66px;
        line-height: 66px;
        text-align: center;
        background-color: #e8f7f0;
        border: 1px solid #c8ebd9;
        border-radius: 50%;
        color: #16a36a;
        font-size: 34px;
        font-weight: 700;
      }

      .eyebrow {
        display: inline-block;
        margin-top: 23px;
        padding: 7px 12px;
        background-color: #e8f7f0;
        color: #128558;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .main-title {
        margin: 20px 0 12px;
        color: #183b65;
        font-size: 29px;
        line-height: 1.35;
        font-weight: 800;
        letter-spacing: -1px;
      }

      .highlight-name {
        color: #0b9688;
      }

      .description {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.9;
      }

      .success-card {
        margin-top: 30px;
        padding: 22px;
        background-color: #f1faf6;
        border: 1px solid #d8efe3;
        border-radius: 12px;
      }

      .success-card-title {
        margin: 0 0 9px;
        color: #147b53;
        font-size: 15px;
        font-weight: 700;
      }

      .success-card-text {
        margin: 0;
        color: #5c806e;
        font-size: 12px;
        line-height: 1.8;
      }

      .credential-card {
        margin-top: 23px;
        padding: 20px;
        background-color: #f5f9ff;
        border: 1px solid #e3ebf6;
        border-radius: 12px;
      }

      .credential-title {
        margin: 0 0 15px;
        color: #183b65;
        font-size: 14px;
        font-weight: 700;
      }

      .credential-label {
        margin: 0 0 6px;
        color: #8492a6;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.6px;
      }

      .credential-value {
        margin: 0;
        color: #183b65;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.7;
        word-break: break-word;
      }

      .credential-divider {
        height: 1px;
        margin: 14px 0;
        background-color: #e3ebf6;
      }

      .security-note {
        margin-top: 23px;
        padding: 16px 17px;
        background-color: #fff9ed;
        border-left: 3px solid #e9ad49;
        border-radius: 5px;
        color: #8b6a35;
        font-size: 12px;
        line-height: 1.8;
      }

      .closing-note {
        margin-top: 25px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.8;
      }

      .email-footer {
        padding: 25px 35px 30px;
        background-color: #f8fafc;
        border-top: 1px solid #edf1f5;
        text-align: center;
      }

      .footer-title {
        margin: 0 0 8px;
        color: #183b65;
        font-size: 13px;
        font-weight: 700;
      }

      .footer-text {
        margin: 0;
        color: #94a3b8;
        font-size: 11px;
        line-height: 1.8;
      }

      .footer-brand {
        color: #0b9688;
        font-weight: 700;
      }

      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 20px 10px !important;
        }

        .email-header {
          padding: 23px 22px !important;
        }

        .email-content {
          padding: 32px 22px 28px !important;
        }

        .main-title {
          font-size: 25px !important;
        }

        .success-card,
        .credential-card {
          padding: 17px !important;
        }

        .email-footer {
          padding: 22px 18px !important;
        }
      }
    </style>
  </head>

  <body>
    <!-- Hidden Preheader -->
    <div
      style="
        display: none;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        color: transparent;
        visibility: hidden;
      "
    >
      Congratulations! Your PixelCare doctor application has been approved.
    </div>

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      class="email-wrapper"
    >
      <tr>
        <td align="center">
          <!-- Main Email Container -->
          <table
            role="presentation"
            width="580"
            cellpadding="0"
            cellspacing="0"
            border="0"
            class="email-container"
            style="
              width: 100%;
              max-width: 580px;
              background-color: #ffffff;
              border-radius: 16px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td class="email-header" style="padding: 30px 40px">
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td>
                      <span class="brand-icon">&#10010;</span>
                    </td>
                    <td>
                      <span class="brand-name">PixelCare</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td class="email-content" style="padding: 42px 40px 35px">
                <!-- Success Icon -->
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td class="success-icon">&#10003;</td>
                  </tr>
                </table>

                <span class="eyebrow"> Application Approved </span>

                <h1 class="main-title">
                  Congratulations, Dr.
                  <span class="highlight-name"><%= name %></span>!
                </h1>

                <p class="description">
                  We are delighted to inform you that your application to join
                  the PixelCare healthcare network as a doctor has been
                  successfully reviewed and approved.

                  <br /><br />

                  Welcome to our growing community of healthcare professionals.
                  We look forward to having you on board!
                </p>

                <!-- Approval Status Card -->
                <div class="success-card">
                  <p class="success-card-title">
                    &#10003; Your Application Has Been Approved
                  </p>

                  <p class="success-card-text">
                    You are now approved to join PixelCare as a healthcare
                    professional. You can access your account and start setting
                    up your professional profile.
                  </p>
                </div>

                <!-- Login Credentials -->
                <div class="credential-card">
                  <p class="credential-title">Your Account Credentials</p>

                  <p class="credential-label">Temporary Password</p>

                  <p class="credential-value"><%= password %></p>

                  <div class="credential-divider"></div>

                  <p class="success-card-text">
                    Use your registered email address and the temporary password
                    provided above to log in to your PixelCare doctor account.
                  </p>
                </div>

                <!-- Security Notice -->
                <div class="security-note">
                  <strong>&#128274; Important Security Reminder</strong>
                  <br /><br />

                  For your account security, please change your temporary
                  password immediately after your first login. Never share your
                  login credentials with anyone. PixelCare will never ask you to
                  disclose your password.
                </div>

                <!-- Closing Message -->
                <p class="closing-note">
                  We are excited to support you in managing your appointments,
                  consultations, and professional healthcare activities through
                  PixelCare.

                  <br /><br />

                  Thank you for choosing to be part of our network.

                  <br /><br />

                  <strong style="color: #183b65">
                    Welcome aboard, Doctor!
                  </strong>
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                class="email-footer"
                style="padding: 25px 35px 30px; text-align: center"
              >
                <p class="footer-title">Your Health, Our Priority.</p>

                <p class="footer-text">Secure healthcare, made simple.</p>

                <p class="footer-text" style="margin-top: 15px">
                  &copy; <%= new Date().getFullYear() %>
                  <span class="footer-brand">PixelCare</span>. All rights
                  reserved.
                </p>

                <p class="footer-text" style="margin-top: 5px">
                  This is an automated message. Please do not reply to this
                  email.
                </p>
              </td>
            </tr>
          </table>
          <!-- End Main Email Container -->
        </td>
      </tr>
    </table>
  </body>
</html>
